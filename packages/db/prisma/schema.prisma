  origenLab   String?   @map("origen_lab") @db.Uuid
  destinoLab  String?   @map("destino_lab") @db.Uuid
  estado      String    @default("abierta") @db.VarChar(20)
  detalle     String?
  /// Ensayos del catálogo (cat_ensayo.id) derivados al laboratorio de destino (align_frente_k.sql).
  ensayos         String[]  @default([]) @db.Uuid
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime? @map("updated_at") @db.Timestamptz
  anuladaAt       DateTime? @map("anulada_at") @db.Timestamptz
  anuladaPor      String?   @map("anulada_por") @db.Uuid
  motivoAnulacion String?   @map("motivo_anulacion")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
