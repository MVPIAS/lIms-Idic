  tenantId      String    @map("tenant_id") @db.Uuid
  otId          String    @map("ot_id") @db.Uuid
  veredicto     String    @db.VarChar(20)
  organismo     String    @db.VarChar(10)
  destino       String?   @db.VarChar(20)
  formatoId     String?   @map("formato_id") @db.Uuid
