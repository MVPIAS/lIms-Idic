/// Resultado de ensayo. Las columnas de estado/fórmula las habilita
/// `packages/db/align_resultado_estado.sql` (aplicar ANTES de desplegar esta
/// versión del modelo; el Dockerfile de la API corre `prisma generate` en el
/// build, así que el cliente se regenera solo al redesplegar).
model Resultado {
  id         String    @id @default(uuid()) @db.Uuid
  otId       String?   @map("ot_id") @db.Uuid
  muestraId  String    @map("muestra_id") @db.Uuid
  /// Analito LEGACY (tabla `analito`). Nullable: los resultados del PUENTE usan
  /// catAnalitoId en su lugar y dejan analitoId en NULL (align_puente_catalogo.sql).
  analitoId  String?   @map("analito_id") @db.Uuid
  replicas   Json      @default("[]")
  promedio   Decimal?  @db.Decimal(18, 6)
  desviacion Decimal?  @db.Decimal(18, 6)
  cv         Decimal?  @db.Decimal(8, 2)
  unidad     String?   @db.VarChar(30)
  veredicto  String?   @db.VarChar(20)
  analistaId String?   @map("analista_id") @db.Uuid
  fecha      DateTime  @default(now()) @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  /// RF-D04.1/D04.2 · Equipo con el que se ejecutó el ensayo. OPCIONAL: NULL en
  /// resultados históricos y en capturas que no informan equipo. Cuando se
  /// informa, ResultadoService.capturar() llama a EquiposService.verificarApto()
  /// ANTES de persistir y BLOQUEA (409) si el equipo está descalibrado / fuera
  /// de servicio; sólo un equipo apto llega a guardarse aquí. Sin relación
  /// Prisma: la tabla `equipo` la gestiona equipos.module.ts vía SQL crudo
  /// (fuera del schema), igual que otros enlaces cross-dominio. La columna la
  /// añade packages/db/align_resultado_equipo.sql.
  equipoId   String?   @map("equipo_id") @db.Uuid

  /// RF-A06/D02.1 · Motor de fórmulas. `resultadoFinal` es el valor que
  /// devolvió la fórmula del analito (NULL si el analito no tiene fórmula: en
  /// ese caso el valor del ensayo es `promedio`). `formulaAplicada` es la copia
  /// del texto de la fórmula en el instante de la captura — `Analito.formula`
  /// es editable, y sin esta copia un resultado ya emitido dejaría de ser
  /// reproducible en cuanto alguien corrigiese la fórmula del catálogo.
  resultadoFinal   Decimal?  @map("resultado_final") @db.Decimal(18, 6)
  formulaAplicada  String?   @map("formula_aplicada")

  /// RF-E01 · Aprobación escalonada: capturado → revisado_n1 → aprobado
  /// (+ rechazado / devuelto hacia atrás). El vocabulario y las transiciones
  /// viven en `apps/api/src/common/estados.ts` (dominio "resultado").
  /// Las columnas físicas conservan el sufijo `_n1` que ya usaba schema.sql.
  estado           String    @default("capturado") @db.VarChar(20)
  revisadoPor      String?   @map("revisado_n1_por") @db.Uuid
  revisadoAt       DateTime? @map("revisado_n1_at") @db.Timestamptz
  aprobadoPor      String?   @map("aprobado_por") @db.Uuid
  aprobadoAt       DateTime? @map("aprobado_at") @db.Timestamptz
  motivoDevolucion String?   @map("motivo_devolucion")
  /// Analista al que la jefatura asignó este ensayo (align_flujo_laboratorio.sql).
  asignadoA        String?   @map("asignado_a") @db.Uuid
  /// Formulario de captura estándar (align_flujo_laboratorio.sql §7).
  tipoDato         String?   @map("tipo_dato") @db.VarChar(12)
  requisito        String?
  observacion      String?
  lecturas         Json?
  especOrigen      String    @default("catalogo") @map("espec_origen") @db.VarChar(10)
  especCatalogo    Json?     @map("espec_catalogo")
  especEditadaPor  String?   @map("espec_editada_por") @db.Uuid
  especEditadaAt   DateTime? @map("espec_editada_at") @db.Timestamptz
  /// Ejecución del ensayo (align_recepcion_custodia_equipo_lme.sql): fecha y hora,
  /// temperatura (°C), humedad relativa (%) e incertidumbre, junto al equipo usado.
  fechaEnsayo      DateTime? @map("fecha_ensayo") @db.Timestamptz
  temperatura      Decimal?  @db.Decimal(6, 2)
  humedad          Decimal?  @db.Decimal(5, 2)
  incertidumbre    String?   @db.VarChar(60)

  /// PUENTE catálogo v2 (align_puente_catalogo.sql). Un resultado del puente se
  /// materializa desde un cat_metodo/cat_analito del panel del elemento, con la
  /// especificación (limiteInf/nominal/limiteSup) y la fórmula ARRASTRADAS —
  /// copia congelada del catálogo en el instante de generar el análisis. En ese
  /// caso analitoId es NULL. `unidad`/`veredicto` (arriba) se reutilizan.
  catAnalitoId String? @map("cat_analito_id") @db.Uuid
  catMetodoId  String? @map("cat_metodo_id") @db.Uuid
  limiteInf    String? @map("limite_inf")
  nominal      String?
  limiteSup    String? @map("limite_sup")
  formula      String?
  /// Valor capturado del resultado del puente (columnas ya existentes en
  /// schema.sql, ahora mapeadas). `valorNumerico` cuando el valor es numérico
  /// (habilita el contraste con los límites); `valorTexto` guarda siempre la
  /// forma textual (admite resultados cualitativos: 'cumple', 'Declarado'…).
  valorNumerico Decimal? @map("valor_numerico") @db.Decimal(18, 6)
  valorTexto    String?  @map("valor_texto") @db.VarChar(120)
  /// Reapertura de un resultado aprobado (align_correcciones_manuales.sql):
  /// quién, cuándo y por qué; `reaperturas` cuenta las veces. Traza completa en ot_historial.
  reabiertoPor    String?   @map("reabierto_por") @db.Uuid
  reabiertoAt     DateTime? @map("reabierto_at") @db.Timestamptz
  reabiertoMotivo String?   @map("reabierto_motivo")
  reaperturas     Int       @default(0)
  /// Factor de la fórmula de este ensayo en la OT (align_quimicos_recepcion_calculo.sql):
  /// copia del método (origen «metodo») o ajustado en la orden («orden», con quién,
  /// cuándo y motivo). `valorSinFactor` es el valor calculado antes del factor.
  factorValor       Decimal?  @map("factor_valor") @db.Decimal(18, 6)
  factorOperacion   String?   @map("factor_operacion") @db.VarChar(12)
  factorDescripcion String?   @map("factor_descripcion") @db.VarChar(120)
  factorOrigen      String?   @map("factor_origen") @db.VarChar(10)
  factorEditadoPor  String?   @map("factor_editado_por") @db.Uuid
  factorEditadoAt   DateTime? @map("factor_editado_at") @db.Timestamptz
  factorMotivo      String?   @map("factor_motivo")
  valorSinFactor    Decimal?  @map("valor_sin_factor") @db.Decimal(18, 6)
  /// Variables extra de la fórmula usadas en la captura (masa, volumen…).
  variables         Json?

  muestra    Muestra   @relation(fields: [muestraId], references: [id], onDelete: Cascade)
  analito    Analito?  @relation(fields: [analitoId], references: [id])
  catAnalito CatAnalito? @relation(fields: [catAnalitoId], references: [id])
  catMetodo  CatMetodo?  @relation(fields: [catMetodoId], references: [id])

  @@index([otId])
  @@index([muestraId])
  @@index([estado, fecha])
  @@index([equipoId])
  @@index([catAnalitoId])
  @@index([catMetodoId])
  @@map("resultado")
}

model PlantillaInforme {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  repid      String    @db.VarChar(20)
  nombre     String    @db.VarChar(160)
  tipo       String    @db.VarChar(20)
  emision    String    @default("conjunto") @db.VarChar(12)
  archivoRef String?   @map("archivo_ref") @db.VarChar(200)
  // Cuerpo del documento en HTML con placeholders {{campo}} (align_certificado.sql).
  // Sin él la plantilla es una cáscara y el motor cae a la plantilla por defecto.
  cuerpoHtml String?   @map("cuerpo_html")
  version    String    @default("v1") @db.VarChar(10)
  activo     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  certificados Certificado[]

  @@unique([tenantId, repid, nombre])
  @@map("plantilla_informe")
}

model Certificado {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  otId            String    @map("ot_id") @db.Uuid
  codigo          String    @db.VarChar(40)
  tipo            String?   @db.VarChar(40)
  plantillaId     String?   @map("plantilla_id") @db.Uuid
  hashSha256      String?   @map("hash_sha256") @db.VarChar(64)
  urlVerificacion String?   @map("url_verificacion") @db.VarChar(300)
  // --- Emisión real (align_certificado.sql) ---
  // Correlativo CERT-AAAA-NNNN generado por el sistema. Se escribe también en
  // `codigo`, cuyo UNIQUE(tenantId, codigo) cierra la unicidad a nivel de BD.
  numero             String?   @db.VarChar(30)
  // Código corto imprimible para validar el certificado en papel (anti-repudio).
  codigoVerificacion String?   @map("codigo_verificacion") @db.VarChar(24)
  // HTML canónico sellado: sha256(documentoHtml) == hashSha256. Es lo que hace
  // la verificación reproducible aunque los resultados de la OT cambien luego.
  documentoHtml      String?   @map("documento_html")
  emitidoPor         String?   @map("emitido_por") @db.Uuid
  fecha           DateTime  @default(now()) @db.Timestamptz
  estado          String    @default("emitido") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  // --- Circuito de firma, versión, anulación y entrega (align_firma_cierre.sql) ---
  // estado: en_firma -> oficial | devuelto | anulado ('emitido' = previo al circuito).
  tipoDocumento        String?   @map("tipo_documento") @db.VarChar(40)
  unidadId             String?   @map("unidad_id") @db.Uuid
  version              Int       @default(1)
  reemplazaId          String?   @map("reemplaza_id") @db.Uuid
  oficialAt            DateTime? @map("oficial_at") @db.Timestamptz
  devueltoAt           DateTime? @map("devuelto_at") @db.Timestamptz
  devueltoPor          String?   @map("devuelto_por") @db.Uuid
  devueltoMotivo       String?   @map("devuelto_motivo")
  anuladoAt            DateTime? @map("anulado_at") @db.Timestamptz
  anuladoPor           String?   @map("anulado_por") @db.Uuid
  anuladoMotivo        String?   @map("anulado_motivo")
  entregadoAt          DateTime? @map("entregado_at") @db.Timestamptz
  entregaMedio         String?   @map("entrega_medio") @db.VarChar(40)
  entregaDestinatario  String?   @map("entrega_destinatario") @db.VarChar(200)
  entregaObservacion   String?   @map("entrega_observacion")
  entregaRegistradaPor String?   @map("entrega_registrada_por") @db.Uuid

  plantilla       PlantillaInforme? @relation(fields: [plantillaId], references: [id])
  ot              OrdenTrabajo      @relation(fields: [otId], references: [id])
  firmas          DocumentoFirma[]

  @@unique([tenantId, codigo])
  @@index([otId])
  @@index([codigoVerificacion])
  @@map("certificado")
}

/// Paso de firma de un informe/certificado, resuelto con la matriz flujo_firma
/// al emitir. DDL: packages/db/align_firma_cierre.sql
model DocumentoFirma {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  certificadoId  String    @map("certificado_id") @db.Uuid
  orden          Int
  accion         String    @db.VarChar(20)
  rolCodigo      String    @map("rol_codigo") @db.VarChar(60)
  rolNombre      String?   @map("rol_nombre") @db.VarChar(200)
  unidadId       String?   @map("unidad_id") @db.Uuid
  unidadCodigo   String?   @map("unidad_codigo") @db.VarChar(40)
  unidadNombre   String?   @map("unidad_nombre") @db.VarChar(200)
  obligatorio    Boolean   @default(true)
  descripcion    String?
  /// [{ usuarioId, nombre, via }] resueltos por la matriz al emitir.
  responsables   Json      @default("[]")
  /// pendiente | firmado | devuelto | anulado
  estado         String    @default("pendiente") @db.VarChar(20)
  firmadoPor     String?   @map("firmado_por") @db.Uuid
  firmadoAt      DateTime? @map("firmado_at") @db.Timestamptz
  firmanteNombre String?   @map("firmante_nombre") @db.VarChar(200)
  firmanteCargo  String?   @map("firmante_cargo") @db.VarChar(200)
  firmanteGrado  String?   @map("firmante_grado") @db.VarChar(80)
  via            String?   @db.VarChar(20)
  imagenData     String?   @map("imagen_data")
  imagenHash     String?   @map("imagen_hash") @db.VarChar(64)
  hashFirma      String?   @map("hash_firma") @db.VarChar(64)
  motivo         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  certificado    Certificado @relation(fields: [certificadoId], references: [id], onDelete: Cascade)

  @@index([certificadoId, orden])
  @@index([tenantId, estado])
  @@map("documento_firma")
}

// =============================================================================
// RBAC · permisos (Rol ya existe; relación por escalar rol_id)
// =============================================================================

