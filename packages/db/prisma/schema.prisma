// =============================================================================
// NÚCLEO LIMS · muestras, ensayos/métodos, analitos, resultados, certificados
// Ejes de clasificación: Producto (Gran Grupo→Grupo) + tipos de muestra
// =============================================================================

model GranGrupo {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  codigo   String   @db.VarChar(10)
  nombre   String   @db.VarChar(120)
  activo   Boolean  @default(true)

  grupos   Grupo[]

  @@unique([tenantId, codigo])
  @@map("gran_grupo")
}

model Grupo {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  granGrupoId  String    @map("gran_grupo_id") @db.Uuid
  cgrupo       String?   @db.VarChar(10)
  nombre       String    @db.VarChar(160)
  activo       Boolean   @default(true)

  granGrupo    GranGrupo @relation(fields: [granGrupoId], references: [id])
  muestras     Muestra[]

  @@index([granGrupoId])
  @@map("grupo")
}

model TipoMuestra {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  codigo    String    @db.VarChar(60)
  nombre    String    @db.VarChar(200)
  activo    Boolean   @default(true)

  parent    TipoMuestra?  @relation("TipoMuestraArbol", fields: [parentId], references: [id])
  hijos     TipoMuestra[] @relation("TipoMuestraArbol")
  muestras  Muestra[]

  @@unique([tenantId, codigo])
  @@map("tipo_muestra")
}

model Muestra {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  otId          String?   @map("ot_id") @db.Uuid
  codigo        String    @db.VarChar(30)
  nombre        String?   @db.VarChar(200)
  tipoMuestraId String?   @map("tipo_muestra_id") @db.Uuid
  granGrupoId   String?   @map("gran_grupo_id") @db.Uuid
  grupoId       String?   @map("grupo_id") @db.Uuid
  clienteId     String?   @map("cliente_id") @db.Uuid
  codigoBarras  String?   @map("codigo_barras") @db.VarChar(60)
  ubicacion     String?   @db.VarChar(120)
  estado        String    @default("recibida") @db.VarChar(30)
  /// PUENTE catálogo v2 (align_puente_catalogo.sql): elemento del catálogo del
  /// que procede la muestra. NULL en muestras legacy.
  catElementoId String?   @map("cat_elemento_id") @db.Uuid
  /// Veredicto de la muestra (agregado de sus ensayos). align_flujo_laboratorio.sql §7.
  veredicto     String?   @db.VarChar(20)
  veredictoAt   DateTime? @map("veredicto_at") @db.Timestamptz
  /// Recepción (align_quimicos_recepcion_calculo.sql): toma de muestra (código de
  /// parametro_sistema «toma_muestra»), condición Cumple / No cumple con
  /// observación, sello, identificación dada por el cliente y otros laboratorios.
  tomaMuestra           String?   @map("toma_muestra") @db.VarChar(60)
  condicionRecepcion    String?   @map("condicion_recepcion") @db.VarChar(10)
  condicionObservacion  String?   @map("condicion_observacion")
  selloNumero           String?   @map("sello_numero") @db.VarChar(200)
  identificacionCliente String?   @map("identificacion_cliente") @db.VarChar(300)
  requiereOtrosLabs     Boolean   @default(false) @map("requiere_otros_labs")
  otrosLabs             String[]  @default([]) @map("otros_labs") @db.Uuid
  otrosLabsDetalle      String?   @map("otros_labs_detalle")
  recepcionadaAt        DateTime? @map("recepcionada_at") @db.Timestamptz
  recepcionadaPor       String?   @map("recepcionada_por") @db.Uuid
  /// Última corrección de la recepción (align_revision_r3.sql): recepcionada_* no cambian al corregir.
  recepcionCorregidaPor String?   @map("recepcion_corregida_por") @db.Uuid
  recepcionCorregidaAt  DateTime? @map("recepcion_corregida_at") @db.Timestamptz
  /// Recepción R1 (align_recepcion_custodia_equipo_lme.sql): Nº de muestra interno
  /// (correlativo por tenant), sellos verificados, destino de la muestra
  /// (analisis | testigo | custodia | contramuestra), fecha hasta la que se
  /// retiene y campos propios del laboratorio (parametro_sistema recepcion_campo).
  numeroInterno         BigInt?   @map("numero_interno")
  numeroInternoPor      String?   @map("numero_interno_por") @db.Uuid
  numeroInternoAt       DateTime? @map("numero_interno_at") @db.Timestamptz
  sellosVerificados     Boolean?  @map("sellos_verificados")
  claseCustodia         String?   @map("clase_custodia") @db.VarChar(20)
  retenerHasta          DateTime? @map("retener_hasta") @db.Date
  datosRecepcion        Json      @default("{}") @map("datos_recepcion")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  tipoMuestra   TipoMuestra? @relation(fields: [tipoMuestraId], references: [id])
  grupo         Grupo?       @relation(fields: [grupoId], references: [id])
  resultados    Resultado[]

  @@unique([tenantId, codigo])
  @@index([otId])
  @@map("muestra")
}

model Metodo {
