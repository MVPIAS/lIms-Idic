// LIMS IDIC · Prisma schema
// Derivado de ../../../02_diseno/schema.sql
// Para sincronizar: pnpm prisma db pull (lee de PostgreSQL) o regenerar manual
//
// Este archivo modela las tablas más utilizadas por la app. Para tablas legacy
// menos usadas (audit_log particionado, etc.) se accede vía $queryRaw.

generator client {
  provider        = "prisma-client-js"
  // "native" para dev local; "linux-musl-openssl-3.0.x" para el contenedor Alpine (OpenSSL 3).
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, pg_trgm, btree_gin]
}

// ============================================================================
// MULTI-TENANT
// ============================================================================

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  codigo        String   @unique @db.VarChar(40)
  nombre        String   @db.VarChar(200)
  rut           String?  @db.VarChar(20)
  zonaHoraria   String   @default("America/Santiago") @map("zona_horaria") @db.VarChar(40)
  moneda        String   @default("CLP") @db.VarChar(3)
  ivaPct        Decimal  @default(19.00) @map("iva_pct") @db.Decimal(5, 2)
  config        Json     @default("{}")
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  usuarios      Usuario[]
  clientes      Cliente[]
  cotizaciones  Cotizacion[]
  ots           OrdenTrabajo[]

  @@map("tenant")
}

// ============================================================================
// ORGANIZACIÓN
// ============================================================================

model Sede {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  codigo    String   @db.VarChar(20)
  nombre    String   @db.VarChar(120)
  direccion String?
  ciudad    String?  @db.VarChar(80)
  region    String?  @db.VarChar(80)
  pais      String   @default("Chile") @db.VarChar(40)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  unidades  Unidad[]

  @@unique([tenantId, codigo])
  @@map("sede")
}

model Unidad {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  sedeId          String   @map("sede_id") @db.Uuid
  codigo          String   @db.VarChar(20)
  nombre          String   @db.VarChar(200)
  descripcion     String?
  jefeUsuarioId   String?  @map("jefe_usuario_id") @db.Uuid
  activa          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  // Árbol organizacional (packages/db/align_admin_roles.sql).
  // tipo: DIRECCION | DEPARTAMENTO | SECCION | LABORATORIO | SUCURSAL | DELEGACION | APOYO
  tipo            String?  @db.VarChar(20)
  padreId         String?  @map("padre_id") @db.Uuid
  sigla           String?  @db.VarChar(20)
  icono           String?  @db.VarChar(8)
  color           String?  @db.VarChar(20)
  codsucdel       String?  @db.VarChar(40)
  centroCosto     String?  @map("centro_costo") @db.VarChar(40)
  orden           Int?     @default(0)
  /// Tipo de documento con que emite la unidad y su rama por defecto
  /// (align_correcciones_manuales.sql; BPCH → INFORME_INSPECCION). NULL = el de la plantilla.
  tipoDocumentoDefecto String? @map("tipo_documento_defecto") @db.VarChar(40)

  sede            Sede     @relation(fields: [sedeId], references: [id])
  padre           Unidad?  @relation("UnidadArbol", fields: [padreId], references: [id])
  hijos           Unidad[] @relation("UnidadArbol")
  jefes           UnidadJefe[]
  usuarioRoles    UsuarioRol[]
  flujosFirma     FlujoFirma[] @relation("FlujoFirmaUnidad")
  flujosFirmaDestino FlujoFirma[] @relation("FlujoFirmaDestino")
  ordenesTrabajo  OrdenTrabajo[] @relation("OtUnidadPrincipal")

  @@unique([tenantId, codigo])
  @@map("unidad")
}

// ============================================================================
// USUARIOS · RBAC
// ============================================================================

model Usuario {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  username         String    @db.Citext
  email            String?   @db.Citext
  nombreCompleto   String    @map("nombre_completo") @db.VarChar(200)
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  totpSecret       String?   @map("totp_secret") @db.VarChar(120)
  totpActivo       Boolean   @default(false) @map("totp_activo")
  estado           String    @default("activo") @db.VarChar(20)
  ultimoLoginAt    DateTime? @map("ultimo_login_at") @db.Timestamptz
  ultimoLoginIp    String?   @map("ultimo_login_ip") @db.Inet
  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  tokenVersion     Int       @default(0) @map("token_version")
  // align_comercial_usuarios.sql · cambio de contraseña obligatorio (alta / restablecimiento)
  debeCambiarPassword Boolean @default(false) @map("debe_cambiar_password")
  passwordCambiadaAt  DateTime? @map("password_cambiada_at") @db.Timestamptz
  grado            String?   @db.VarChar(80)
  cargo            String?   @db.VarChar(200)
  userLims         String?   @map("user_lims") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  usuarioRoles     UsuarioRol[]
  jefaturas        UnidadJefe[]
  cotizacionesCreadas Cotizacion[] @relation("CotizacionCreada")

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@map("usuario")
}

model Rol {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  codigo        String   @db.VarChar(40)
  nombre        String   @db.VarChar(120)
  descripcion   String?
  esSistema     Boolean  @default(false) @map("es_sistema")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  // align_admin_roles.sql · nivel: OPERATIVO|JEFATURA|DIRECCION|SOPORTE|SISTEMA
  // alcance: UNIDAD|DESCENDENCIA|GLOBAL · aliasDe: código canónico (JEFELAB → JEFE_LAB)
  nivel         String?  @db.VarChar(20)
  alcance       String?  @db.VarChar(20)
  orden         Int?     @default(0)
  aliasDe       String?  @map("alias_de") @db.VarChar(40)
  usuarioRoles  UsuarioRol[]
  rolPermisos   RolPermiso[]
  flujosFirma   FlujoFirma[]

  @@unique([tenantId, codigo])
  @@map("rol")
}

model UsuarioRol {
  // PK sintética: permite el MISMO rol en varias unidades (JEFE_LAB en 2 labs).
  // La unicidad real "no duplicar (usuario, rol, unidad)" la garantiza un ÍNDICE
  // ÚNICO por expresión COALESCE(unidad_id,'000…') creado en
  // packages/db/align_rbac_unidad.sql (Prisma no puede modelar índices por
  // expresión, por eso no aparece como @@unique aquí).
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  rolId         String   @map("rol_id") @db.Uuid
  unidadId      String?  @map("unidad_id") @db.Uuid
  vigenteDesde  DateTime @default(now()) @map("vigente_desde") @db.Timestamptz
  vigenteHasta  DateTime? @map("vigente_hasta") @db.Timestamptz

  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol           Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)
  // FK usuario_rol_unidad_id_fkey (NOT VALID) creada en align_admin_roles.sql.
  unidad        Unidad?  @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([rolId])
  @@map("usuario_rol")
}

// Hasta 2 Jefes de Laboratorio por unidad (titular + subrogante). Complementa
// unidad.jefe_usuario_id (jefe titular legacy, mantenido por compatibilidad).
// DDL: packages/db/align_rbac_unidad.sql
model UnidadJefe {
  tenantId    String   @map("tenant_id") @db.Uuid
  unidadId    String   @map("unidad_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  rol         String   @default("titular") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  unidad      Unidad   @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([unidadId, usuarioId])
  @@map("unidad_jefe")
}

// ============================================================================
// CLIENTES (con validación RUT chileno)
// ============================================================================

model Cliente {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  codigo          String?   @db.VarChar(20)
  rut             String    @db.VarChar(20)
  razonSocial     String    @map("razon_social") @db.VarChar(200)
  nombreFantasia  String?   @map("nombre_fantasia") @db.VarChar(200)
  giro            String?   @db.VarChar(200)
  tipo            String?   @db.VarChar(30)
  direccion       String?
  ciudad          String?   @db.VarChar(80)
  region          String?   @db.VarChar(80)
  telefono        String?   @db.VarChar(40)
  email           String?   @db.Citext
  fechaRegistro   DateTime  @default(dbgenerated("CURRENT_DATE")) @map("fecha_registro") @db.Date
  diasCredito     Int       @default(30) @map("dias_credito")
  bloqueado       Boolean   @default(false)
  motivoBloqueo   String?   @map("motivo_bloqueo")
  saldoActual     Decimal   @default(0) @map("saldo_actual") @db.Decimal(14, 2)
  notas           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  plantas         Planta[]
  cotizaciones    Cotizacion[]
  ots             OrdenTrabajo[]

  @@unique([tenantId, rut])
  @@map("cliente")
}

model Planta {
  id         String  @id @default(uuid()) @db.Uuid
  clienteId  String  @map("cliente_id") @db.Uuid
  codigo     String  @db.VarChar(20)
  nombre     String  @db.VarChar(200)
  direccion  String?
  ciudad     String? @db.VarChar(80)
  region     String? @db.VarChar(80)
  telefono   String? @db.VarChar(40)
  activa     Boolean @default(true)

  cliente    Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, codigo])
  @@map("planta")
}

// ============================================================================
// COTIZACIÓN
// ============================================================================

model Cotizacion {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  codigo            String              @db.VarChar(30)
  clienteId         String              @map("cliente_id") @db.Uuid
  plantaId          String?             @map("planta_id") @db.Uuid
  fechaEmision      DateTime            @default(dbgenerated("CURRENT_DATE")) @map("fecha_emision") @db.Date
  validezDias       Int                 @default(30) @map("validez_dias")
  expiraAt          DateTime?           @map("expira_at") @db.Date
  estado            String              @default("borrador") @db.VarChar(20)
  subtotal          Decimal             @default(0) @db.Decimal(14, 2)
  descuentoPct      Decimal             @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  descuentoMonto    Decimal             @default(0) @map("descuento_monto") @db.Decimal(14, 2)
  gastosAdminPct    Decimal             @default(0) @map("gastos_admin_pct") @db.Decimal(5, 2)
  gastosAdminMonto  Decimal             @default(0) @map("gastos_admin_monto") @db.Decimal(14, 2)
  // D2 · segundo camino de costeo (estimación por laboratorio).
  viaCosteo             String          @default("precio_fijo") @map("via_costeo") @db.VarChar(20)
  utilidadPct           Decimal         @default(0) @map("utilidad_pct") @db.Decimal(5, 2)
  utilidadMonto         Decimal         @default(0) @map("utilidad_monto") @db.Decimal(14, 2)
  costosDirectosTotal   Decimal         @default(0) @map("costos_directos_total") @db.Decimal(14, 2)
  neto              Decimal             @default(0) @db.Decimal(14, 2)
  ivaPct            Decimal             @default(19) @map("iva_pct") @db.Decimal(5, 2)
  ivaMonto          Decimal             @default(0) @map("iva_monto") @db.Decimal(14, 2)
  total             Decimal             @default(0) @db.Decimal(14, 2)
  formato           String?             @db.VarChar(20)
  formaPago         String?             @map("forma_pago") @db.VarChar(80)
  ejecutivoId       String?             @map("ejecutivo_id") @db.Uuid
  notas             String?
  condicionesParticulares Json           @default("{}") @map("condiciones_particulares")
  // Comercial R1/R2 (oct-2026) · DDL: packages/db/align_comercial_r2.sql
  centroCostoId          String?        @map("centro_costo_id") @db.Uuid
  referencia             String?        @db.VarChar(300)
  descripcionTecnica     String?        @map("descripcion_tecnica")
  condicionesAdicionales String?        @map("condiciones_adicionales") @db.VarChar(2000)
  /// Plazo de entrega comprometido, días corridos desde la recepción (align_firma_cierre.sql).
  /// La OT lo usa para su fecha de compromiso (disparador trg_ot_fecha_compromiso).
  plazoEntregaDias       Int?           @map("plazo_entrega_dias")
  observacionesInternas  String?        @map("observaciones_internas")
  moneda                 String         @default("CLP") @db.VarChar(3)
  dolarValor             Decimal?       @map("dolar_valor") @db.Decimal(12, 4)
  dolarFecha             DateTime?      @map("dolar_fecha") @db.Date
  dolarMotivo            String?        @map("dolar_motivo")
  validaHasta            DateTime?      @map("valida_hasta") @db.Date
  tipoClienteCodigo      String?        @map("tipo_cliente_codigo") @db.VarChar(60)
  medioEnvio             String?        @map("medio_envio") @db.VarChar(40)
  aceptacionTipo         String?        @map("aceptacion_tipo") @db.VarChar(30)
  aceptacionNumero       String?        @map("aceptacion_numero") @db.VarChar(60)
  aceptacionFecha        DateTime?      @map("aceptacion_fecha") @db.Date
  aceptacionAdjunto      String?        @map("aceptacion_adjunto") @db.VarChar(300)
  conCobro               Boolean        @default(true) @map("con_cobro")
  aceptadaAt             DateTime?      @map("aceptada_at") @db.Timestamptz
  aceptadaPor            String?        @map("aceptada_por") @db.Uuid
  anulacionMotivo        String?        @map("anulacion_motivo")
  anuladaAt              DateTime?      @map("anulada_at") @db.Timestamptz
  // align_comercial_usuarios.sql · momento en que pasó a «Vencida» (estado expirada)
  vencidaAt              DateTime?      @map("vencida_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @default(now()) @map("updated_at") @db.Timestamptz
  createdBy         String?             @map("created_by") @db.Uuid

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  cliente           Cliente             @relation(fields: [clienteId], references: [id])
  ejecutivo         Usuario?            @relation("CotizacionCreada", fields: [ejecutivoId], references: [id])
  lineas            LineaCotizacion[]

  @@unique([tenantId, codigo])
  @@index([clienteId, estado])
  @@map("cotizacion")
}

model LineaCotizacion {
  id              String     @id @default(uuid()) @db.Uuid
  cotizacionId    String     @map("cotizacion_id") @db.Uuid
  tipo            String     @default("producto") @db.VarChar(30)
  descripcion     String?
  categoria       String?    @db.VarChar(80)
  cantidad        Int        @default(1)
  diasOHoras      Decimal?   @map("dias_o_horas") @db.Decimal(8, 2)
  precioUnitario  Decimal    @map("precio_unitario") @db.Decimal(14, 2)
  descuentoPct    Decimal    @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  subtotal        Decimal    @db.Decimal(14, 2)
  tramo           String?    @db.VarChar(200)
  orden           Int?
  // Línea = ensayo del catálogo (código EN) valorizado por su ficha (R1).
  catEnsayoId     String?    @map("cat_ensayo_id") @db.Uuid
  ensayoCodigo    String?    @map("ensayo_codigo") @db.VarChar(30)

  cotizacion      Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@map("linea_cotizacion")
}

// ============================================================================
// ORDEN DE TRABAJO
// ============================================================================

model OrdenTrabajo {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  codigo                String    @db.VarChar(30)
  cotizacionId          String?   @map("cotizacion_id") @db.Uuid
  clienteId             String    @map("cliente_id") @db.Uuid
  plantaId              String?   @map("planta_id") @db.Uuid
  unidadPrincipal       String?   @map("unidad_principal") @db.Uuid
  flujoInstanciaId      String?   @map("flujo_instancia_id") @db.Uuid
  prioridad             String    @default("normal") @db.VarChar(20)
  fechaRecepcion        DateTime? @map("fecha_recepcion") @db.Timestamptz
  fechaCompromiso       DateTime? @map("fecha_compromiso") @db.Date
  fechaCierre           DateTime? @map("fecha_cierre") @db.Timestamptz
  solicitante           String?   @db.VarChar(200)
  numeroLey             String?   @map("numero_ley") @db.VarChar(40)
  origenTrabajo         String?   @map("origen_trabajo") @db.VarChar(120)
  estado                String    @default("recepcionada") @db.VarChar(40)
  subdireccionAsignada  String?   @map("subdireccion_asignada") @db.VarChar(255)
  tipoTrabajo           String?   @map("tipo_trabajo") @db.VarChar(120)
  documentoWord         String?   @map("documento_word") @db.VarChar(120)
  fechaEntregaCliente   DateTime? @map("fecha_entrega_cliente") @db.Date
  fechaRecepDco         DateTime? @map("fecha_recep_dco") @db.Date
  diasAtraso            Int       @default(0) @map("dias_atraso")
  medioEnvio            String?   @map("medio_envio") @db.VarChar(40)
  estadoEnvio           String    @default("No enviado") @map("estado_envio") @db.VarChar(40)
  descripcionTrabajo    String?   @map("descripcion_trabajo")
  notas                 String?
  // D1 · OT dual (Genérico/Comercial <-> Definitivo/Técnico) y estados reales.
  faseRegistro          String    @default("generico") @map("fase_registro") @db.VarChar(20)
  estadoOt              String    @default("en_espera") @map("estado_ot") @db.VarChar(30)
  elementoGenerico      String?   @map("elemento_generico") @db.VarChar(240)
  catElementoId         String?   @map("cat_elemento_id") @db.Uuid
  ocNumero              String?   @map("oc_numero") @db.VarChar(40)
  cotizacionNumero      String?   @map("cotizacion_numero") @db.VarChar(40)
  enEsperaAt            DateTime? @map("en_espera_at") @db.Timestamptz
  registradoAt         DateTime? @map("registrado_at") @db.Timestamptz
  // Comercial R2 (oct-2026) · origen (en origenTrabajo: COTIZACION | INTERNACION |
  // DISPOSICION | INTERLABORATORIO | OT_INTERNA; textos heredados se conservan),
  // cobro y OPI pendiente. DDL: packages/db/align_comercial_r2.sql
  conCobro              Boolean   @default(true) @map("con_cobro")
  disposicionRef        String?   @map("disposicion_ref") @db.VarChar(120)
  disposicionFecha      DateTime? @map("disposicion_fecha") @db.Date
  opiPendiente          Boolean   @default(false) @map("opi_pendiente")
  opiNumero             String?   @map("opi_numero") @db.VarChar(60)
  opiFecha              DateTime? @map("opi_fecha") @db.Date
  opiRegistradaAt       DateTime? @map("opi_registrada_at") @db.Timestamptz
  centroCostoId         String?   @map("centro_costo_id") @db.Uuid
  labSolicitanteCcId    String?   @map("lab_solicitante_cc_id") @db.Uuid
  horasHombre           Decimal   @default(0) @map("horas_hombre") @db.Decimal(10, 2)
  costoEstimado         Decimal   @default(0) @map("costo_estimado") @db.Decimal(14, 2)
  // Laboratorio responsable: quién y cuándo lo fijó o cambió por última vez
  // (historial completo en ot_historial). DDL: packages/db/align_flujo_laboratorio.sql
  unidadAsignadaPor     String?   @map("unidad_asignada_por") @db.Uuid
  unidadAsignadaAt      DateTime? @map("unidad_asignada_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  cliente               Cliente   @relation(fields: [clienteId], references: [id])
  unidad                Unidad?   @relation("OtUnidadPrincipal", fields: [unidadPrincipal], references: [id])
  certificados          Certificado[]
  qcControles           QcControl[]

  @@unique([tenantId, codigo])
  @@index([clienteId, estado])
  @@index([unidadPrincipal, estado])
  @@map("orden_trabajo")
}

// ============================================================================
// CONTROL DE CALIDAD (QC) del flujo real — DDL: packages/db/align_qc.sql
// Blancos / estándares / curvas de calibración / duplicados por OT × cat_metodo.
// Bloquea la emisión de informe si un método con qcRequerido no tiene un
// control con resultado 'aprobado' para esa OT (contrato 4.3.7 / 4.3.8).
// ============================================================================

model QcControl {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  otId            String    @map("ot_id") @db.Uuid
  catMetodoId     String    @map("cat_metodo_id") @db.Uuid
  tipo            String    @db.VarChar(30) // blanco | estandar | curva | duplicado
  valorEsperado   Decimal?  @map("valor_esperado") @db.Decimal
  valorObtenido   Decimal?  @map("valor_obtenido") @db.Decimal
  criterio        String?
  resultado       String    @default("pendiente") @db.VarChar(20) // aprobado | rechazado | pendiente
  rCuadrado       Decimal?  @map("r_cuadrado") @db.Decimal
  recuperacionPct Decimal?  @map("recuperacion_pct") @db.Decimal
  cvPct           Decimal?  @map("cv_pct") @db.Decimal
  aprobadoPor     String?   @map("aprobado_por") @db.VarChar(120)
  aprobadoAt      DateTime? @map("aprobado_at") @db.Timestamptz
  /// Independencia (align_correcciones_manuales.sql): quién registró el control,
  /// qué dio la evaluación automática y quién lo aprobó (id). Quien registra no aprueba.
  registradoPor   String?   @map("registrado_por") @db.Uuid
  evaluacion      String?   @db.VarChar(20)
  aprobadoPorId   String?   @map("aprobado_por_id") @db.Uuid
  observaciones   String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  ot              OrdenTrabajo @relation(fields: [otId], references: [id])
  catMetodo       CatMetodo    @relation(fields: [catMetodoId], references: [id])

  @@index([otId])
  @@index([catMetodoId])
  @@index([tenantId])
  @@map("qc_control")
}

