  @@map("decision_conformidad")
}

// ============================================================================
// CONFIGURACIÓN DE SISTEMA
// ============================================================================

// Configuración SMTP del sistema. Una fila por tenant (unique tenant_id).
// On-premise: `host` apunta al relay SMTP interno del IDIC (LAN, sin internet).
// La tabla la crea packages/db/align_configuracion.sql; aquí se modela para
// que la API la tipe vía Prisma Client.
model ConfiguracionCorreo {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  host            String?  @db.VarChar(255)
  puerto          Int      @default(587)
  seguridad       String   @default("starttls") @db.VarChar(16) // none | starttls | tls
  usuario         String?  @db.VarChar(255)
  passwordCifrada String?  @map("password_cifrada")
  remitenteNombre String?  @map("remitente_nombre") @db.VarChar(200)
  remitenteEmail  String?  @map("remitente_email") @db.VarChar(255)
  activo          Boolean  @default(false)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([tenantId])
  @@map("configuracion_correo")
}

// ============================================================================
// PARÁMETROS DE NEGOCIO (§5) · maestra genérica de combos editables
// ----------------------------------------------------------------------------
// Un valor por (categoria, codigo). Reemplaza los combos que estaban
// hardcodeados en el frontend (tipo_cliente, forma_pago, prioridad,
// tipo_linea_costeo, tipo_inspeccion). Ver packages/db/align_parametros.sql.
// ============================================================================

model ParametroSistema {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  categoria String   @db.VarChar(60)
  codigo    String   @db.VarChar(60)
  etiqueta  String   @db.VarChar(160)
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  // Dato técnico del código (no visible en el combo): regla de validez del
  // tipo_cliente (EJERCITO|PARTICULAR), números de validez_cotizacion…
  valor     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([tenantId, categoria, codigo])
  @@index([tenantId, categoria, orden])
  @@map("parametro_sistema")
}

// ============================================================================
// CONSUMIBLES · inventario por lotes + KARDEX (contrato §4.4.4 / §4.4.5)
// Alineado por packages/db/align_consumibles.sql. El acceso en tiempo de
// ejecución es vía SQL crudo (apps/api/src/consumibles), estos modelos
// documentan la forma de las tablas y las incluyen en `prisma generate`.
// ============================================================================

model Consumible {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  codigo       String   @db.VarChar(40)
  nombre       String   @db.VarChar(200)
  tipo         String?  @db.VarChar(40)
  unidadMedida String?  @map("unidad_medida") @db.VarChar(20)
  proveedorId  String?  @map("proveedor_id") @db.Uuid
  stockMinimo  Decimal? @map("stock_minimo") @db.Decimal
  activo       Boolean? @default(true)

  lotes LoteConsumible[]

  @@unique([tenantId, codigo])
  @@map("consumible")
}

model LoteConsumible {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  consumibleId     String    @map("consumible_id") @db.Uuid
  numeroLote       String    @map("numero_lote") @db.VarChar(80)
  fechaRecepcion   DateTime? @map("fecha_recepcion") @db.Date
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  cantidadInicial  Decimal?  @map("cantidad_inicial") @db.Decimal
  cantidadActual   Decimal?  @map("cantidad_actual") @db.Decimal
  ubicacionId      String?   @map("ubicacion_id") @db.Uuid
  estado           String?   @default("disponible") @db.VarChar(30)

  consumible   Consumible             @relation(fields: [consumibleId], references: [id])
  movimientos  MovimientoConsumible[]

  @@unique([consumibleId, numeroLote])
  @@index([tenantId])
  @@index([consumibleId])
  @@map("lote_consumible")
}

model MovimientoConsumible {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  loteId      String   @map("lote_id") @db.Uuid
  tipo        String   @db.VarChar(20) // entrada | consumo | ajuste
  cantidad    Decimal  @db.Decimal
  muestraId   String?  @map("muestra_id") @db.Uuid
  catMetodoId String?  @map("cat_metodo_id") @db.Uuid
  motivo      String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  lote LoteConsumible @relation(fields: [loteId], references: [id])

  @@index([tenantId])
  @@index([loteId, createdAt])
  @@index([muestraId])
  @@map("movimiento_consumible")
}

/// Correlativo del Nº de muestra interno por tenant (align_recepcion_custodia_equipo_lme.sql).
/// Se usa con UPDATE … RETURNING (SQL crudo) para que sea atómico.
model CorrelativoMuestra {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  ultimo    BigInt   @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("correlativo_muestra")
}
