{
  "//": "LIMS IDIC · Panel de operación · Aiuken. Se provisiona solo (ver lims.yml). Diseñado para responder de un vistazo: ¿está el LIMS en pie, hay copias y cuánto margen queda?",
  "title": "LIMS IDIC · Operación",
  "uid": "lims-idic-operacion",
  "tags": ["lims", "idic", "aiuken"],
  "timezone": "America/Santiago",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "API del LIMS",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "lims_api_salud", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CAÍDA", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "OK", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "PostgreSQL",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "lims_postgres_activo", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CAÍDO", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "OK", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Última copia (horas)",
      "description": "Si supera 26 h, el respaldo diario no se está ejecutando.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "lims_backup_horas_desde_ultimo", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 26 }, { "color": "red", "value": 48 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Certificado TLS (días)",
      "description": "Sin ACME no hay renovación automática. Tramitar con la CA del Ejército con 30 días de margen.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "lims_certificado_dias_restantes", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 60 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Alertas activas",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "lims_alertas_activas", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Tamaño de la base",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "lims_postgres_tamano_bytes", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "Uso de disco por ruta (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "lims_disco_uso_pct", "legendFormat": "{{ruta}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 85 }, { "color": "red", "value": 95 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memoria del host",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "en uso", "refId": "A" },
        { "expr": "node_memory_MemTotal_bytes", "legendFormat": "total", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "CPU por contenedor",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "rate(container_cpu_usage_seconds_total{name=~\"lims-.*\"}[5m])", "legendFormat": "{{name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "timeseries",
      "title": "Memoria por contenedor",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "container_memory_working_set_bytes{name=~\"lims-.*\"}", "legendFormat": "{{name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "Conexiones a PostgreSQL",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "lims_postgres_conexiones", "legendFormat": "en uso", "refId": "A" },
        { "expr": "lims_postgres_conexiones_max", "legendFormat": "máximo", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reinicios de contenedor (acumulado)",
      "description": "Una línea que sube es un contenedor en bucle de reinicio.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "lims_contenedor_reinicios", "legendFormat": "{{contenedor}}", "refId": "A" }]
    }
  ]
}
