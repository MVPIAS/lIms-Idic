# =============================================================================
# LIMS IDIC · PRODUCCIÓN ON-PREMISE · variables de entorno · Aiuken
# =============================================================================
# El instalador (instalar-onpremise.sh) copia esta plantilla a /opt/lims-idic/.env
# y GENERA automáticamente los secretos marcados como <<GENERAR>>.
#
# Este fichero contiene las credenciales de un sistema con datos reales del
# Ejército de Chile. Permisos obligatorios: chmod 600, propietario root.
# NUNCA se sube a un repositorio ni se envía por correo.
# =============================================================================

# --- Identidad del despliegue ------------------------------------------------
# Nombre DNS interno del servidor. Debe COINCIDIR con el CN/SAN del certificado
# y estar resuelto por el DNS del cuartel (o por /etc/hosts de los clientes).
# No es un dominio público: no se registra en Internet.
DOMAIN=lims.idic.ejercito.cl

# Versión del producto desplegada. Debe coincidir con la etiqueta de las
# imágenes cargadas desde los .tar (ver MANIFIESTO.txt del kit).
LIMS_VERSION=1.0.0
LIMS_REGISTRY=lims-idic

# --- Rutas de datos en el host ----------------------------------------------
# TODO el estado persistente vive aquí. Es lo único que hay que respaldar.
# Debe estar en un volumen con espacio suficiente (ver GUIA_ONPREMISE.md §2).
LIMS_DATA_DIR=/srv/lims-idic

# Destino de las copias de seguridad. Idealmente un disco/NAS DISTINTO del que
# aloja LIMS_DATA_DIR: un backup en el mismo disco no protege de un fallo físico.
LIMS_BACKUP_DIR=/srv/lims-backup

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=lims
POSTGRES_PASSWORD=<<GENERAR>>
POSTGRES_DB=lims_idic
# Base de Metabase (paneles e informes de BI). Separada de la del LIMS.
METABASE_DB=lims_metabase

# --- Seguridad API -----------------------------------------------------------
# JWT_SECRET: mínimo 32 caracteres. La API ABORTA el arranque si falta o es corto.
JWT_SECRET=<<GENERAR>>

# Duración de la sesión y bloqueo por intentos fallidos de ingreso.
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
AUTH_MAX_INTENTOS=5
AUTH_LOCK_MINUTES=15

# --- Directorio Activo del Ejército (LDAP) -----------------------------------
# Con LDAP_ENABLED=false (por defecto) solo entran los usuarios LOCALES del LIMS.
# Para ingresar con las cuentas del dominio, TI del IDIC debe aportar:
#   LDAP_URL               ldap://<controlador-de-dominio>:389  (o ldaps://...:636)
#   LDAP_BIND_DN           cuenta de servicio de SOLO LECTURA (DN completo)
#   LDAP_BIND_CREDENTIALS  contraseña de esa cuenta
#   LDAP_SEARCH_BASE       OU donde están los usuarios del IDIC
# El servidor del LIMS necesita alcanzar el controlador de dominio por la red
# interna (regla de cortafuegos hacia el puerto 389/636).
LDAP_ENABLED=false
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_CREDENTIALS=
LDAP_SEARCH_BASE=
# Vacío = filtro estándar de Directorio Activo: (sAMAccountName={{username}})
LDAP_SEARCH_FILTER=

# --- Verificación de informes y certificados ---------------------------------
# URL impresa en el pie y en el QR de informes y certificados para comprobar su
# autenticidad: la pantalla pública /verificar/<código> del propio LIMS.
# Vacío = https://<DOMAIN>/verificar  (el propio servidor interno). Solo cámbiela
# si el IDIC publica la verificación en otro dominio (p. ej. uno accesible desde
# Internet); el QR de los documentos ya emitidos no cambia.
URL_VERIFICACION=

# --- Integración IBIS (armas) ------------------------------------------------
# Carpeta del HOST donde IBIS/SFTP deja el XML diario. El instalador crea
# entrada/, procesados/ y errores/. El barrido corre a IBIS_CRON_HORA.
IBIS_DIR=/srv/lims-idic/ibis
IBIS_CRON_HABILITADO=true
IBIS_CRON_HORA=02:00

# --- MinIO (documentos, informes y certificados firmados) --------------------
MINIO_ROOT_USER=lims-minio
MINIO_ROOT_PASSWORD=<<GENERAR>>

# --- Imágenes de terceros ----------------------------------------------------
# Etiquetas fijadas por exportar-imagenes.sh. minio y metabase se re-etiquetan a
# ":lims-idic" a propósito: sus upstreams solo publican ":latest", que es una
# etiqueta móvil y por tanto NO reproducible. Al re-etiquetar, la versión que se
# validó en preproducción queda congelada en el .tar.
CADDY_IMAGE=caddy:2-alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:lims-idic
METABASE_IMAGE=metabase/metabase:lims-idic

# --- Monitorización y alertas ------------------------------------------------
# Relay SMTP INTERNO del Ejército (no un SaaS: el servidor no sale a Internet).
# Si se deja vacío, chequeo-salud.sh registra las alertas en el journal del
# sistema pero NO envía correo. Se recomienda encarecidamente configurarlo.
ALERTA_SMTP_HOST=
ALERTA_SMTP_PORT=25
ALERTA_MAIL_DE=lims-idic@ejercito.cl
ALERTA_MAIL_PARA=soporte.idic@ejercito.cl

# Umbrales de vigilancia
UMBRAL_DISCO_PCT=85          # % de uso de disco que dispara alerta
UMBRAL_CERT_DIAS=30          # días antes de caducar el certificado para avisar
UMBRAL_BACKUP_HORAS=26       # horas sin backup correcto que disparan alerta

# --- Retención de copias (política GFS) --------------------------------------
RETENCION_DIARIOS=7
RETENCION_SEMANALES=4
RETENCION_MENSUALES=12

# --- PITR: basebackup + WAL archiving (ver PITR.md) --------------------------
# Cuántos basebackups semanales se conservan. El WAL archivado se conserva desde
# el START del basebackup MÁS ANTIGUO retenido: con 4, la ventana PITR es de ~1
# mes hacia atrás. Cada basebackup ocupa aprox. el tamaño de la base comprimida.
RETENCION_BASEBACKUPS=4

# Horas sin un WAL nuevo archivado que disparan alerta. Con archive_timeout=300s
# debería llegar uno cada 5 min como mucho; 2 h de silencio indica que el
# archivado está FALLANDO (riesgo de que pg_wal llene el disco). Ver PITR.md.
UMBRAL_WAL_ARCHIVO_HORAS=2
# Días sin un basebackup correcto que disparan alerta (se hace semanal).
UMBRAL_BASEBACKUP_DIAS=8
